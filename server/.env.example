# MySQL connection used by Prisma at runtime and by migrations
DATABASE_URL="mysql://app:app@localhost:3306/playbooks"
# At least 32 characters
JWT_SECRET="replace-with-a-random-string-of-at-least-32-chars"
PORT=4000
# Separate database used by integration tests (must be a different database)
TEST_DATABASE_URL="mysql://root:root@localhost:3307/playbooks_test"
